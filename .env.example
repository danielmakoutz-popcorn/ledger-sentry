LEDGER_PASSWORD=replace-with-a-long-password
LEDGER_SECRET_KEY=replace-with-at-least-32-random-characters
LEDGER_ALERT_PERCENT=10
LEDGER_ALERT_DOLLARS=5
LEDGER_SYNC_MINUTES=240

# Optional automatic bank sync through Plaid.
# Start with sandbox. Production access requires your own Plaid configuration/approval.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Optional for institutions that require an OAuth redirect. Register the same HTTPS URL in Plaid.
PLAID_REDIRECT_URI=
